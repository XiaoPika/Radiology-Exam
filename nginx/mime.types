    image/png                             png;
    image/svg+xml                         svg svgz;
    image/x-icon                          ico;
    application/x-font-ttf                ttf;
    font/opentype                         otf;
    application/octet-stream              eot;
    font/woff                             woff;
    font/woff2                            woff2;
    video/mp4                             mp4;
    video/webm                            webm;
    application/dicom                     dcm;
}
