# ==============================================================================
# 医学影像问卷系统 (Radiology Exam System) 环境变量配置
# ==============================================================================

# 服务外部端口（Nginx 宿主机对外映射端口）
PORT=9020

# 数据库配置（单机 Docker 部署默认指向内置 db 容器服务）
DB_HOST=db
DB_PORT=3306
DB_NAME=radiology_exam
DB_USER=radiology
DB_PASSWORD=radiology123
DB_ROOT_PASSWORD=radiology_root_secret

# 默认超级管理员初始账号与密码（首次部署启动自动创建，固定默认账号 user，密码 admin）
ADMIN_USERNAME=user
ADMIN_PASSWORD=admin

# JWT 令牌签名密钥（生产环境请修改为随机高强度字符串）
SECRET_KEY=radiology-exam-secret-key-change-in-production-2026

# DICOM 及病例压缩包上传大小上限（MB）
UPLOAD_MAX_SIZE_MB=500
